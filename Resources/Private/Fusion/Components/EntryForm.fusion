#
# The form of an entry: a new one, or one that is changed.
#
# The fields of the form are named after the namespace of the module arguments, so that the
# backend hands them to the action of the module.
#
prototype(Sitegeist.SlopMachine:Component.EntryForm) < prototype(Neos.Fusion:Component) {
    @propTypes {
        @strict = false
        form = ${PropTypes.any}
    }

    form = ${form}

    @private {
        i18n = ${I18n.id('').source('Main').package('Sitegeist.SlopMachine')}

        saveUri = Neos.Fusion:UriBuilder {
            action = ${props.form.mode == 'edit' ? 'update' : 'create'}
            format = 'htmx'
            arguments.instruction = ${props.form.mode == 'edit' ? props.form.id : null}
        }
        cancelUri = Neos.Fusion:UriBuilder {
            action = 'index'
            format = 'htmx'
            arguments.instruction = ${props.form.mode == 'edit' ? props.form.id : null}
        }
    }

    renderer = afx`
        <div class="slopmachine-instructions-detail">
            <h2>{private.i18n.id(props.form.mode == 'edit' ? 'form.editHeadline' : 'form.createHeadline').translate()}</h2>
            <form
                class="neos-form"
                hx-post={private.saveUri}
                hx-target="#slopmachine-agent-instructions"
                hx-swap="outerHTML"
            >
                <div class="neos-form-field">
                    <label class="neos-form-label" for="slopmachine-instruction-title">
                        {private.i18n.id('form.title').translate()}
                    </label>
                    <input
                        class="neos-form-input"
                        type="text"
                        id="slopmachine-instruction-title"
                        name="moduleArguments[title]"
                        value={props.form.title}
                    />
                </div>
                <div class="neos-form-field">
                    <label class="neos-form-label" for="slopmachine-instruction-instructions">
                        {private.i18n.id('form.instructions').translate()}
                    </label>
                    <textarea
                        class="neos-form-textarea"
                        id="slopmachine-instruction-instructions"
                        name="moduleArguments[instructions]"
                        rows="18"
                    >{props.form.instructions}</textarea>
                </div>
                <p class="neos-form-hint" @if={props.form.error != null}>{props.form.error}</p>
                <div class="neos-form-actions">
                    <button type="submit" class="neos-button neos-button-primary">
                        <i class="fas fa-check icon-white"></i> {private.i18n.id('action.save').translate()}
                    </button>
                    <button
                        type="button"
                        class="neos-button"
                        hx-get={private.cancelUri}
                        hx-target="#slopmachine-agent-instructions"
                        hx-swap="outerHTML"
                    >
                        {private.i18n.id('action.cancel').translate()}
                    </button>
                </div>
            </form>
        </div>
    `
}
