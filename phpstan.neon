parameters:
    level: 8
    phpVersion: 80300
    paths:
        - Classes
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        - '#Call to an undefined method [a-zA-Z0-9\\_]+Repository::findOneBy[a-zA-Z]+\(\)#'
        - '#Call to an undefined method Neos\\Eel\\FlowQuery\\FlowQuery::find\(\)#'
